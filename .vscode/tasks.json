{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Zniffer: Build Docker image",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/zniffer-image.py",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
