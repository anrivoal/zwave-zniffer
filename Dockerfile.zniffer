FROM debian:trixie-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config libevent-dev libssl-dev libxml2-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY CMakeLists.txt ./
COPY src ./src
COPY assets ./assets
RUN cmake -S . -B /build -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF && \
    cmake --build /build --target zniffer_service -j2

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    libevent-2.1-7t64 libssl3t64 libxml2 libstdc++6 ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && useradd --system --uid 10001 --home /nonexistent zniffer
WORKDIR /app
COPY --from=build /build/zniffer_service /app/zniffer_service
COPY --from=build /src/assets /app/assets
COPY web /app/web
ARG APP_VERSION=dev
LABEL org.opencontainers.image.title="Z-Wave Zniffer" \
      org.opencontainers.image.version="${APP_VERSION}"
ENV ZW_PORT=8080 ZW_WEB_ROOT=/app/web ZW_XML_ROOT=/app/assets/xml
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
    CMD curl --fail --silent "http://127.0.0.1:${ZW_PORT}/api/health" >/dev/null || exit 1
CMD ["/app/zniffer_service"]
